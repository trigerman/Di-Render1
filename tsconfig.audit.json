{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
    ,"resolveJsonModule": true
  },
  "include": [
    "app/src/domain/data/**/*.ts",
    "app/src/domain/analysis/**/*.ts",
    "app/src/domain/plots/**/*.ts",
    "app/src/domain/stats/**/*.ts",
    "app/src/domain/data/schema.ts",
    "app/src/domain/data/source.ts",
    "app/src/domain/project/portable.ts",
    "app/src/domain/project/history.ts",
    "app/src/domain/project/schema.ts",
    "app/src/domain/project/migrations.ts",
    "app/src/domain/export/exporters.ts",
    "app/src/domain/templates/templates.ts",
    "app/src/domain/scientific/elements.ts",
    "app/src/assets/catalog.ts",
    "app/src/platform/desktopFiles.ts",
    "app/src/domain/storage/projectStorage.ts",
    "app/src/domain/storage/figureLibrary.ts"
  ]
}
